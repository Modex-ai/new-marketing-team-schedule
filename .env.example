# Copy to .env (server.js reads it) or set these in your hosting panel.
# Owner sign-in until the owner sets a personal password
ADMIN_PIN=
# Any long random string — signs the sessions (keep it secret; changing it signs everyone out)
SESSION_SECRET=
OWNER_NAME=Ibrahim
# Team report sheets (Google Apps Script web app — see apps-script/Code.gs)
REPORTS_URL=
REPORTS_KEY=
# Telegram bot from @BotFather (optional)
TELEGRAM_BOT_TOKEN=
# Storage: "fs" keeps the data as files in DATA_DIR (any server). Leave empty on Vercel (uses Vercel Blob).
STORAGE=fs
DATA_DIR=./data
# Only on Vercel / for scripts/export-data.mjs
BLOB_READ_WRITE_TOKEN=
PORT=3000
